{"index": 19, "id": 4857, "video": "二轮车辆闯入_20230721144136_突发事件_33393747.mp4", "video_path": "/root/autodl-tmp/高架桥数据/video_fixed/二轮车辆闯入_20230721144136_突发事件_33393747.mp4", "gt_label": "二轮车辆闯入", "clips": [{"clip_id": 0, "frame_indices": [0, 14, 28, 43, 57, 71], "raw": "2023年02月21日星期四14时41分29秒，在外环高速蕴川立交东路段，一辆红色货车停靠在最左侧车道，车辆开启双闪灯，驾驶员下车后在车旁停留，后方多辆车辆减速绕行，该事件符合“PARKING”判断标准。", "parsed": {"collision": false, "close_multi_stop": false, "accident": false, "parking": false, "congestion": false, "construction": false, "twowheel": false, "debris": false, "label": null}}, {"clip_id": 1, "frame_indices": [72, 86, 100, 115, 129, 143], "raw": "2023年02月21日星期四14时41分32秒，在外环高速蕴川立交东路段，一辆二轮摩托车从右侧车道驶入主路，行驶于多车道高速公路的最左侧车道，与正常行驶的机动车并，未在专用非机动车道或辅道行驶，且该路段无明显二轮车通行标志，属于禁止二轮车通行的区域，该二轮车驾驶员佩戴头盔，车辆无明显牌照，其行为对周边正常行驶的机动车造成潜在安全隐患，构成典型二轮车辆闯入交通事件。", "parsed": {"collision": false, "close_multi_stop": false, "accident": false, "parking": false, "congestion": false, "construction": false, "twowheel": false, "debris": false, "label": "二轮车辆闯入"}}, {"clip_id": 2, "frame_indices": [144, 158, 173, 187, 202, 216], "raw": "ACCIDENT: 否\nPARKING: 是\nCONGESTION: 是\nCONSTRUCTION: 否\nTWOWHEEL: 是\nDEBRIS: 否", "parsed": {"collision": false, "close_multi_stop": false, "accident": false, "parking": true, "congestion": true, "construction": false, "twowheel": true, "debris": false, "label": null}}], "eaca_label": "二轮车辆闯入", "eaca_reason": "twowheel_clip_evidence", "error": null, "signal_counts": {"parking": 1, "congestion": 1, "twowheel": 1}, "clip_label_counts": {"二轮车辆闯入": 1}, "eaca_version": "v2_soft"}
{"index": 20, "id": 4859, "video": "二轮车辆闯入_20230720232339_突发事件_33392713.mp4", "video_path": "/root/autodl-tmp/高架桥数据/video_fixed/二轮车辆闯入_20230720232339_突发事件_33392713.mp4", "gt_label": "二轮车辆闯入", "clips": [{"clip_id": 0, "frame_indices": [0, 49, 98, 148, 197, 246], "raw": "2023年7月20日22时23分34秒，外环高速南大路北（内）方向出现二轮车辆闯入交通事件。视频中可见多辆货车及轿车在夜间行驶过程中，一辆白色轿车驶入高速公路主路，其行为属于非机动车闯入高速公路，存在横穿车道的危险驾驶行为。该二轮车辆在车流中穿行，与多辆小汽车并行，导致后方车辆紧急避让，影响了正常交通秩序，构成严重交通安全隐患。", "parsed": {"collision": false, "close_multi_stop": false, "accident": false, "parking": false, "congestion": false, "construction": false, "twowheel": false, "debris": false, "label": "二轮车辆闯入"}}, {"clip_id": 1, "frame_indices": [247, 296, 346, 395, 445, 494], "raw": "2023年7月20日23时23分45秒，在外环高速南大路北（内）路段，一辆白色轿车与前方车辆发生追尾，导致后方多辆轿车紧急刹车，形成明显的交通拥堵，符合多车事故的特征，因此判定为多车事故。", "parsed": {"collision": false, "close_multi_stop": false, "accident": false, "parking": false, "congestion": false, "construction": false, "twowheel": false, "debris": false, "label": "多车事故"}}, {"clip_id": 2, "frame_indices": [495, 544, 594, 643, 693, 742], "raw": "2023年7月20日22时23分55秒至22时24分03秒，外环高速南大路北（内）路段夜间监控画面显示，一辆白色轿车在行车道内突然减速并完全停止，未见驾驶员下车或车辆故障迹象，后方多辆轿车因避让该车而紧急刹车并形成短时拥堵。该白色轿车位于道路中间车道，占据部分行车空间，且长时间静止于非停车区域，导致后方车辆通行受阻，存在安全隐患。现场无施工设施、无抛洒物、无二轮车辆闯入，也无其他事故车辆碰撞痕迹，符合异常停车行为，属于典型异常停车事件。", "parsed": {"collision": false, "close_multi_stop": false, "accident": false, "parking": false, "congestion": false, "construction": false, "twowheel": false, "debris": false, "label": "异常停车"}}], "eaca_label": "二轮车辆闯入", "eaca_reason": "label_majority_fallback", "error": null, "signal_counts": {}, "clip_label_counts": {"二轮车辆闯入": 1, "多车事故": 1, "异常停车": 1}, "eaca_version": "v2_soft"}
